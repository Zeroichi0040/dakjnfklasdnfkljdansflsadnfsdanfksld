# The installer creates a private .env with random secrets. Never commit .env.
APP_ENV=development
APP_NAME=Mithi Bakehouse
APP_TAGLINE=Small batches. Everyday joys.
SECRET_KEY=
PUBLIC_BASE_URL=http://127.0.0.1:5000
# Blank = project database/data/application.sqlite3. PostgreSQL is optional.
# DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST/DB?sslmode=require
DATABASE_URL=
SESSION_COOKIE_SECURE=false
TRUSTED_HOSTS=localhost,127.0.0.1
PROXY_FIX_HOPS=0
SIGNUP_ENABLED=true
# Default deployments use ONE process. Configure shared storage before scaling.
RATELIMIT_STORAGE_URI=memory://
# Development mail is private .eml output, not actual delivery.
# Public production must use disabled or a configured SMTP provider.
MAIL_TRANSPORT=outbox
MAIL_SERVER=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
MAIL_USE_TLS=true
# Optional local Docker PostgreSQL; setup supplies a unique password.
POSTGRES_PASSWORD=
